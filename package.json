{
  "name": "uniflow-schedule",
  "version": "3.0.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "lint": "eslint . && node scripts/check-syntax.mjs",
    "format": "prettier --write scripts tests/e2e .github playwright.config.mjs package.json eslint.config.mjs",
    "format:check": "prettier --check scripts tests/e2e .github playwright.config.mjs package.json eslint.config.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs --channel beta",
    "budget": "node scripts/budgets.mjs",
    "perf": "node scripts/lighthouse.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10"
  }
}
